# Copy to .env and fill in. Never commit .env.
#
# Two kinds of settings:
#   - bootstrap (this file only): port, database, encryption key, first
#     admin, auth issuer, Redis, service addresses;
#   - runtime (everything about searches: sources, shops, timeouts, cache,
#     plans, rate limits, CORS). With a database (docker compose sets
#     DATABASE_URL) they live in Postgres: on the FIRST start the runtime
#     settings below are copied into the database once; after that this
#     file no longer changes them. Change them without a restart with
#       docker compose exec server /owis_find_deal_engine settings list
#       docker compose exec server /owis_find_deal_engine settings set KEY VALUE
#     (see server README "Settings"; the admin panel replaces this later).

# --- Database and settings store (bootstrap) -------------------------------
# Postgres password (docker compose): openssl rand -hex 32  (hex: URL-safe)
POSTGRES_PASSWORD=
# Full stack: set automatically. Server on your machine (compose.dev.yml):
# DATABASE_URL=postgres://ofd:<POSTGRES_PASSWORD>@127.0.0.1:5432/ofd?sslmode=disable
# Empty = no database: all settings from this file, restart to change.
DATABASE_URL=
# Encrypts secret settings (SerpApi key, Apify token) in the database
# (AES-256-GCM): openssl rand -hex 32. Keep a copy: without it the stored
# secrets cannot be read and must be set again.
SETTINGS_ENCRYPTION_KEY=
# How often the server checks the database for changed settings.
SETTINGS_POLL_INTERVAL=10s
# First admin (Firebase account email), added once to an empty admin list.
# Used by the admin API (/admin/v1) and the admin panel.
ADMIN_EMAIL=
# Two-factor admin login (Firebase multi-factor, needs "Identity Platform"
# in the Firebase console). DISABLED FOR NOW (owner, 2026-10-11): admins
# sign in with Firebase + the admin list only; the server logs a warning.
# Keep this setting. TODO before production (phase 4): set it to true.
ADMIN_REQUIRE_2FA=false
# Admin email must be verified (Firebase email link) before its first
# sign-in. DISABLED FOR NOW (owner, 2026-10-11): test admins may use
# made-up emails (e.g. admin@example.com) that cannot receive the link.
# Keep this setting. TODO before production (phase 4): set it to true.
ADMIN_REQUIRE_VERIFIED_EMAIL=false
# Webhooks of the asynchronous search (POST /api/v1/searches with
# "webhook_url"): only https to public addresses by default. true also
# allows plain http and internal addresses (localhost, 192.168.x,
# host.docker.internal) to test with a receiver on your PC. Development
# only: never true in production.
# WEBHOOK_ALLOW_PRIVATE=false
# An admin signs in again after this long (tokens are refreshed hourly,
# the sign-in time stays).
ADMIN_SESSION_MAX_AGE=12h
# Admin web app (http://localhost:3002/admin/): sign-in with Firebase.
# The project's Web API key (Firebase console -> Project settings ->
# General; the same key as for test tokens). Public, not a secret.
ADMIN_FIREBASE_API_KEY=
# Optional: default <AUTH_AUDIENCE>.firebaseapp.com
ADMIN_FIREBASE_AUTH_DOMAIN=

# --- End-user auth (JWT from your auth provider) -------------------------
# Firebase Auth:
#   AUTH_JWKS_URL=https://www.googleapis.com/service_accounts/v1/jwk/securetoken@system.gserviceaccount.com
#   AUTH_ISSUER=https://securetoken.google.com/<firebase-project-id>
#   AUTH_AUDIENCE=<firebase-project-id>
# Supabase, Clerk and Auth0 publish a JWKS URL too; use their issuer/audience.
AUTH_JWKS_URL=
AUTH_ISSUER=
AUTH_AUDIENCE=
# Custom claim holding the user's plan (e.g. set by a payment webhook).
# Missing or unknown plan -> DEFAULT_PLAN.
AUTH_PLAN_CLAIM=plan
# Sign-in methods accepted for app users (Firebase firebase.sign_in_provider).
# Other methods, e.g. Firebase anonymous accounts, get 401. API keys and the
# admin login are not affected. * = any method (needed for auth providers
# other than Firebase).
AUTH_ALLOWED_SIGN_IN=google.com,apple.com,password

# --- Plans and quotas -----------------------------------------------------
# Daily searches per plan. When the default (free) plan runs out -> 402,
# when a paid plan runs out -> 429.
PLANS=free:20,pro:500
DEFAULT_PLAN=free
# Redis password (docker compose): openssl rand -hex 32
REDIS_PASSWORD=
# Usage counters + search cache. Empty = in memory (one instance only).
# Full stack (docker compose up): set automatically, ignore this line.
# Server on your machine (compose.dev.yml): Redis on 127.0.0.1.
REDIS_URL=redis://:${REDIS_PASSWORD}@127.0.0.1:6379/0

# Per-user burst limit (requests per second / burst size).
RATE_LIMIT_RPS=1
RATE_LIMIT_BURST=5

# --- Rules per shop (step 14b) ---------------------------------------------
# Each shop of the catalog has one source, a time limit and a group:
#   SHOP_<SHOP>_SOURCE   serpapi (amazon, ebay: SerpApi's own engine),
#                        apify (APIFY_<SHOP>_* below), web (the providers in
#                        SEARCH_PROVIDERS) or off (not searched, status "off")
#   SHOP_<SHOP>_TIMEOUT  how long one search of the shop may take
#   SHOP_<SHOP>_GROUP    fast or slow (the asynchronous search answers first
#                        when the fast shops are done; step 14b part 3)
# There is no backup source: a shop that fails or runs out of time shows
# its last known results (CACHE_LAST_KNOWN_TTL), else "error".
# Without SHOP_<SHOP>_SOURCE the old lists decide: APIFY_MARKETS -> apify,
# SERPAPI_MARKETS -> serpapi, any other shop -> web.
# Default time limits (owner, 2026-11-09): amazon 15s, ebay 15s,
# aliexpress 60s, temu 45s, shein 30s; groups: amazon and ebay fast, the
# others slow. A shop on the web providers gets the whole chain's time.
# SHOP_SHEIN_SOURCE=off
# SHOP_TEMU_TIMEOUT=45s
# SHOP_AMAZON_GROUP=fast

# --- Search ---------------------------------------------------------------
# Web providers (shops whose source is web), tried in order until one
# succeeds. Use "searxng" alone for $0, or "serpapi" alone.
SEARCH_PROVIDERS=searxng,serpapi
# Self-hosted SearXNG. Full stack: set automatically. Server on your
# machine (compose.dev.yml): published on 127.0.0.1:8888.
SEARXNG_URL=http://127.0.0.1:8888
# Secret for the SearXNG container (docker compose reads it from .env):
#   openssl rand -hex 32
SEARXNG_SECRET=
# SearXNG asks the search engines once per marketplace (in parallel), so a
# big shop like Amazon cannot fill all results. true = one combined
# "(site:a OR site:b)" query: fewer engine requests, worse shop coverage.
SEARXNG_ONE_QUERY=false
# Store, search and category pages are dropped; when a shop's first result
# page leaves fewer than 5 product pages, up to this many pages are read.
SEARXNG_MAX_PAGES=2
# https://serpapi.com/manage-api-key (only needed if serpapi is listed)
SERPAPI_KEY=
# google_shopping = structured prices, seller and image (falls back to a
#                   normal web search when Google Shopping has nothing from
#                   our shops, e.g. thin coverage in a country)
# google          = web search with site: filters (links, rarely prices)
SERPAPI_ENGINE=google_shopping
# Old list (see SHOP_<SHOP>_SOURCE): shops whose source is serpapi, a
# dedicated SerpApi engine instead of the web providers. amazon = SerpApi's Amazon Search API:
# Amazon's own results with price, rating and direct /dp/ links, on the
# country's Amazon (amazon.com, amazon.sa), and eBay's own results with
# price, condition, shipping and direct /itm/ links (usa, ksa). Only the
# SerpApi key is needed, no Amazon / eBay account; 1 search per shop per
# live search. Default: amazon,ebay when SERPAPI_KEY is set. Leave empty
# (SERPAPI_MARKETS=) to turn it off.
#SERPAPI_MARKETS=amazon,ebay
# Tip: SEARCH_PROVIDERS=serpapi,searxng puts the priced results first
# (each live search then costs one SerpApi search).
# Time each provider gets before falling back to the next one.
PROVIDER_ATTEMPT_TIMEOUT=8s
# SerpApi gets longer: Google Shopping often takes 5-15 s, and a search
# that is cut off is still charged by SerpApi.
SERPAPI_TIMEOUT=25s
# Skip a provider for PROVIDER_COOLDOWN after this many failures in a row.
PROVIDER_FAILURE_THRESHOLD=3
PROVIDER_COOLDOWN=1m
# true  = one provider call per search (cheapest: one SerpApi credit when
#         SerpApi answers; SearXNG still queries each shop separately)
# false = one call per marketplace, run in parallel (one credit per shop)
SEARCH_COMBINED=true
# The waiting search (POST /api/v1/search, admin test search). Raised
# automatically to the slowest shop's time limit + 2s.
SEARCH_TIMEOUT=15s
SEARCH_MAX_CONCURRENCY=4

# --- Queue of the shops' live searches (step 14b part 3) -------------------
# Each shop of a search is one task (the same shop + title already queued
# or running is joined, not paid twice), run by a worker pool inside the
# server; in Redis when REDIS_URL is set (survives restarts). Runs at once
# per source; a task waits for a free run up to QUEUE_MAX_WAIT, then the
# shop shows its last known results. Apify's free plan has 8 GB of memory
# = 4 runs of 2048 MB.
QUEUE_APIFY_MAX_RUNS=4
QUEUE_SERPAPI_MAX_RUNS=10
QUEUE_WEB_MAX_RUNS=10
QUEUE_MAX_WAIT=60s
# At most this many results per marketplace (best ranked first).
RESULTS_PER_MARKET=10
# Optional: override the embedded internal/markets/markets.json. With a
# database, the countries and shops are edited in the admin panel (MARKETS
# setting) and that wins over this file.
MARKETS_FILE=
# Estimated cost of one SerpApi search in USD, for the admin test search
# and cost figures (Developer plan: $75 / 5,000 = 0.015; free plan: 0).
SERPAPI_SEARCH_COST_USD=0
# Monthly budget for the estimated cost of SerpApi + Apify in USD (0 = no
# budget). At BUDGET_ALERT_PERCENT and at 100 % the server logs an error and
# writes an audit entry (once per month); the admin dashboard shows it.
# Default 5 = the Apify free credit (owner decision D5, free plans).
BUDGET_MONTHLY_USD=5
BUDGET_ALERT_PERCENT=80

# --- Apify scrapers (optional): real prices for AliExpress / Temu / SHEIN -
# Marketplaces without an official API can use a scraper ("Actor") from the
# Apify store (SHOP_<SHOP>_SOURCE=apify, or the old list APIFY_MARKETS); if
# it fails or is too slow, that shop shows its last known results. Free
# plan: $5 credit/month (roughly 1,000-7,000 results).
#
# Per marketplace:
#   1. pick a scraper on https://apify.com/store (e.g. search "temu scraper")
#   2. its "API" tab shows the Actor id: owner~actor-name -> *_ACTOR
#   3. its "Input" tab -> JSON view: copy the input, replace the search text
#      with {{query}} and the result limit with {{max}} -> *_INPUT
#      ({{country}} / {{COUNTRY}} = us, sa, jo / US, SA, JO)
#      Actors that take a search URL instead of a keyword:
#      {{query_url}}  = samsung+s+pen  (for ...?SearchText={{query_url}})
#      {{query_path}} = samsung%20s%20pen (for .../pdsearch/{{query_path}}/)
#      {{query_slug}} = samsung-s-pen  (for .../wholesale-{{query_slug}}.html)
# Token: https://console.apify.com/settings/integrations
APIFY_TOKEN=
APIFY_MARKETS=
# APIFY_MARKETS=aliexpress,temu,shein
# Tested in the local test (October 2026):
# APIFY_ALIEXPRESS_ACTOR=piotrv1001/aliexpress-listings-scraper
# APIFY_ALIEXPRESS_INPUT={"maxResults":{{max}},"searchQueries":["{{query}}"],"proxyConfiguration":{"useApifyProxy":true}}
# Its prices come without a currency ("currency": null); they are US prices:
# APIFY_ALIEXPRESS_CURRENCY=USD
# APIFY_TEMU_ACTOR=crw/temu-products-scraper
# Its input needs max_items >= 10, so it is fixed at 10. It charges for
# every result it scrapes ($0.10 per run), so keep APIFY_TEMU_MAX_ITEMS=10.
# APIFY_TEMU_INPUT={"keyword":"{{query}}","max_items":10,"region":"US","sort":"relevance"}
# APIFY_TEMU_ACTOR=owner~temu-scraper
# APIFY_TEMU_INPUT={"keyword":"{{query}}","maxItems":{{max}}}
# APIFY_SHEIN_ACTOR=clearpath/shein-product-scraper
# APIFY_SHEIN_INPUT={"enrichDetails":false,"maxItemsPerSearch":{{max}},"quickShip":false,"searchTerms":["{{query}}"],"site":"us","sortBy":"recommend","category":""}
# Not usable for search: shahidirfan/shein-product-scraper ignores a
# /pdsearch/ URL and returns a clothing listing (tested October 2026).
# Results per run (also caps what pay-per-result scrapers charge).
APIFY_MAX_ITEMS=10
# Per shop (overrides APIFY_MAX_ITEMS). Saves money only for scrapers that
# charge per result kept: SHEIN (~$0.0066 per result) yes; Temu no — it
# charges for at least 10 anyway (October 2026).
# APIFY_TEMU_MAX_ITEMS=10
# APIFY_SHEIN_MAX_ITEMS=5
# Max cost of one run, for scrapers billed per event (e.g. the SHEIN one;
# without it Apify aborts the run: "maximum cost of $0.00"). Ignored by
# scrapers billed per result. 0 = not sent.
APIFY_MAX_CHARGE_USD=0.20
# Time limit of an Apify shop that has neither a default (see the rules per
# shop) nor SHOP_<SHOP>_TIMEOUT. Scrapers start a browser: 20-60 s per run
# is normal.
APIFY_TIMEOUT=60s
# Apify is told to stop a run this long before the shop's time limit, so
# what the run found before the stop can still come back (AliExpress 90s ->
# Apify 85s).
APIFY_STOP_MARGIN=5s
# Memory of one run in MB per shop (a power of 2: 1024, 2048, 4096, ...);
# empty = the Actor's default. More memory can make a run faster; for
# scrapers billed per result it should not cost more (check the Actor's
# pricing).
# APIFY_ALIEXPRESS_MEMORY_MB=4096
# No effect since step 14b (there is no backup source any more).
APIFY_EMPTY_FALLBACK=false
# Estimated cost of one run per shop in USD, for the admin test search and
# cost figures (October 2026: Temu 0.10, SHEIN 0.033 for 5, AliExpress 0.02).
# APIFY_TEMU_RUN_COST_USD=0.10
# APIFY_SHEIN_RUN_COST_USD=0.033
# APIFY_ALIEXPRESS_RUN_COST_USD=0.02

# --- Search cache (stale-while-revalidate) --------------------------------
# Stored in Redis when REDIS_URL is set, otherwise in memory. Each shop's
# results are stored on their own: a search runs live only for the shops
# without an answer, and countries share a shop's results when the request
# to the shop is the same (AliExpress, Temu, amazon.com for usa and jor).
CACHE_ENABLED=true
# Served straight from cache while younger than this. 48h keeps the paid
# scraper / SerpApi searches low; prices may be up to 2 days old (the app
# shows them as approximate, the link shows the real price).
CACHE_FRESH_TTL=48h
# A shop that found nothing: retried sooner (never longer than
# CACHE_FRESH_TTL). A shop that failed is never stored.
CACHE_EMPTY_TTL=30m
# No effect since step 14b (results are cached per shop).
CACHE_PARTIAL_TTL=10m
# After FRESH and until STALE: served instantly (stale=true) and refreshed
# in the background. Older results are searched live.
CACHE_STALE_TTL=72h
# A shop's results are kept this long: when its live search fails, they are
# shown with status "last_known" and their date (7 days).
CACHE_LAST_KNOWN_TTL=168h
# "refresh": true (pull to refresh) is ignored for entries younger than this.
CACHE_MIN_REFRESH=10m
# In-memory store size, and parallel background refreshes (queue tasks
# behind the searches).
CACHE_MAX_ENTRIES=10000
CACHE_MAX_BACKGROUND_REFRESH=4

# --- Server -----------------------------------------------------------------
PORT=3002
# docker compose: where the API port is published on the host. Keep
# 127.0.0.1 behind a reverse proxy / Cloudflare Tunnel.
API_BIND=127.0.0.1
API_PORT=3002
VERSION=dev
LOG_LEVEL=info
# Addresses whose CF-Connecting-IP header (the caller's own address) is
# believed: cloudflared, the Cloudflare Tunnel. docker compose sets it
# (10.203.20.10 on the tunnel network); empty = never (go run).
# TRUSTED_PROXIES=
# Browser origins allowed to call the API (web app). Empty = none.
CORS_ALLOWED_ORIGINS=
SHUTDOWN_TIMEOUT=10s
