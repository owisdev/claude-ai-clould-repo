# Copy to .env and fill in. Never commit .env.

# Client apps allowed to call the API: name:sha256hex, comma-separated.
# Create one with: go run ./cmd/keygen mobile
API_KEYS=

# https://serpapi.com/manage-api-key
SERPAPI_KEY=

PORT=3002
LOG_LEVEL=info

# true  = one SerpApi call per search (cheapest)
# false = one call per marketplace, run in parallel (better coverage, costs more)
SEARCH_COMBINED=true
SEARCH_TIMEOUT=15s
SEARCH_MAX_CONCURRENCY=4

# Per API client: requests per second and burst size.
RATE_LIMIT_RPS=1
RATE_LIMIT_BURST=5

# Browser origins allowed to call the API (web app). Empty = none.
CORS_ALLOWED_ORIGINS=

# Optional: override the embedded internal/markets/markets.json.
MARKETS_FILE=

SHUTDOWN_TIMEOUT=10s
